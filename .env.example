# VoxPlan Environment Configuration Template
# Copy to .env for local development overrides (never commit .env to version control)

# Frontend Environment Variables (Vite client-side build)
# Base URL for the FastAPI Machine Learning backend API.
# In local development, the default fallback is http://127.0.0.1:8000.
# In production, set to your backend deployment origin (e.g., https://voxplan-api.example.com).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend Service Configuration (FastAPI / Uvicorn)
HOST=127.0.0.1
PORT=8000

# CORS Configuration
# Comma-separated allowed origins for cross-origin resource sharing.
# Default in development is wildcard ("*"). In production, specify explicit client origins.
# Example: CORS_ORIGINS=https://voxplan-u31l.onrender.com,http://localhost:5173
CORS_ORIGINS=*

# Application Environment Mode
# Values: development, test, staging, production
ENVIRONMENT=development
